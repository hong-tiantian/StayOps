# StayOps ADK agent service config. Copy to .env and fill in your project.
# NO secrets live here: authentication is via Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=1

# Base URL of the Next.js app hosting /api/tools/* (the single source of tool logic + data).
# Local dev: http://localhost:3000 ; production: the Cloud Run app URL.
STAYOPS_TOOLS_URL=http://localhost:3000
