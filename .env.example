# StayOps Gemini (Vertex AI) config. Copy to .env.local and fill in your project.
# No secrets live here: authentication is via Application Default Credentials (ADC).
# Run `gcloud auth application-default login` before using Vertex AI locally.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# Gmail readonly intake. Leave secrets empty in committed files.
# Use /api/auth/gmail/start to authorize a demo inbox, then store the refresh
# token only in .env.local or Cloud Run environment variables.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_OAUTH_SHOW_TOKEN=false
