# StayOps — Gemini (Vertex AI) config. Copy to .env.local and fill in your project.
# NO secrets live here: authentication is via Application Default Credentials (ADC),
# because the org policy disallows API keys. Run `gcloud auth application-default login`.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
